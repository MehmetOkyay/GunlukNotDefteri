rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function giris() { return request.auth != null; }
    function benim(uid) { return giris() && request.auth.uid == uid; }

    match /kullanicilar/{uid} {
      allow read: if giris();
      allow create, update: if benim(uid) && request.resource.data.uid == uid;
      allow delete: if benim(uid);
      match /begenilenGonderiler/{gid} {
        allow read, write: if benim(uid);
      }
      match /cihaz/{belge} {
        allow read, write: if benim(uid);
      }
      match /bildirimler/{bid} {
        allow read: if benim(uid);
        allow delete: if benim(uid);
        allow update: if benim(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['okundu']);
        allow create: if giris()
          && request.auth.uid != uid
          && request.resource.data.gonderenUid == request.auth.uid
          && request.resource.data.okundu == false;
      }
    }

    match /takipler/{id} {
      allow read: if giris();
      allow create: if giris()
        && request.resource.data.takipEden == request.auth.uid
        && request.resource.data.hedef != request.auth.uid
        && id == request.auth.uid + "_" + request.resource.data.hedef;
      allow delete: if giris() && (
        resource.data.takipEden == request.auth.uid
        || resource.data.hedef == request.auth.uid
      );
    }

    match /gonderiler/{id} {
      allow read: if giris();
      allow create: if giris()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.durum == "yayinda";
      allow update: if giris() && (
        resource.data.uid == request.auth.uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['begeniSayisi', 'yorumSayisi'])
      );
      allow delete: if giris() && resource.data.uid == request.auth.uid;
      match /begeniler/{uid} {
        allow read: if giris();
        allow create, delete: if benim(uid);
      }
      match /yorumlar/{yorumId} {
        allow read: if giris();
        allow create: if giris() && request.resource.data.uid == request.auth.uid;
        allow delete: if giris() && (
          resource.data.uid == request.auth.uid
          || get(/databases/$(database)/documents/gonderiler/$(id)).data.uid == request.auth.uid
        );
      }
    }

    match /engeller/{id} {
      allow read: if giris() && (
        resource == null
        || resource.data.eden == request.auth.uid
        || resource.data.hedef == request.auth.uid
      );
      allow create: if giris()
        && request.resource.data.eden == request.auth.uid
        && id == request.auth.uid + "_" + request.resource.data.hedef;
      allow delete: if giris() && resource.data.eden == request.auth.uid;
    }

    match /sohbetler/{id} {
      allow read: if giris() && (
        resource == null || request.auth.uid in resource.data.uyeler
      );
      allow create: if giris()
        && request.auth.uid in request.resource.data.uyeler
        && request.resource.data.uyeler.size() == 2;
      allow update: if giris() && request.auth.uid in resource.data.uyeler;
      allow delete: if giris() && request.auth.uid in resource.data.uyeler;
      match /mesajlar/{mesajId} {
        allow read: if giris()
          && request.auth.uid in get(/databases/$(database)/documents/sohbetler/$(id)).data.uyeler;
        allow create: if giris()
          && request.resource.data.gonderenUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/sohbetler/$(id)).data.uyeler;
        allow update: if giris()
          && request.auth.uid in get(/databases/$(database)/documents/sohbetler/$(id)).data.uyeler;
        allow delete: if giris()
          && request.auth.uid in get(/databases/$(database)/documents/sohbetler/$(id)).data.uyeler;
      }
    }

    match /{path=**}/yorumlar/{yorumId} {
      allow read, delete: if giris() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/begeniler/{begeniUid} {
      allow read, delete: if benim(begeniUid);
    }

    match /medya/{id} {
      allow read: if giris();
      allow create, update: if giris()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.veri.size() > 0
        && request.resource.data.veri.size() < 700000;
      allow delete: if giris() && resource.data.uid == request.auth.uid;
    }

    match /sikayetler/{id} {
      allow create, update: if giris()
        && request.resource.data.sikayetEdenUid == request.auth.uid
        && request.resource.data.durum == "beklemede";
      allow read: if giris() && resource.data.durum == "kaldirildi";
    }
  }
}
