<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/renk_arkaplan"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/renk_kart"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/btnSohbetGeri"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/geri"
            android:padding="8dp"
            android:src="@drawable/ic_calendar_back"
            app:tint="@color/renk_metin_baslik" />

        <LinearLayout
            android:id="@+id/layoutSohbetKisi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <include
                layout="@layout/item_avatar"
                android:layout_width="38dp"
                android:layout_height="38dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textSohbetIsim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/renk_metin_baslik"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Mehmet Okyay" />

                <TextView
                    android:id="@+id/textSohbetKullaniciAdi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/renk_metin_ikincil"
                    android:textSize="12sp"
                    tools:text="\@mehmet" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMesajlar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="8dp" />

        <TextView
            android:id="@+id/textSohbetBos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="32dp"
            android:text="@string/sohbet_bos"
            android:textColor="@color/renk_metin_ikincil"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/textSohbetEngel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/renk_kart"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/renk_metin_ikincil"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/layoutSohbetGiris"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/renk_kart"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp">

        <EditText
            android:id="@+id/editMesaj"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_edittext"
            android:hint="@string/mesaj_yaz_ipucu"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="1000"
            android:maxLines="5"
            android:minHeight="44dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:textColor="@color/renk_metin_baslik"
            android:textColorHint="@color/renk_metin_ipucu"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/btnMesajGonder"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/gonder"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/renk_vurgu" />
    </LinearLayout>
</LinearLayout>
