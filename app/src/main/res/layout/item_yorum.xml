<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <include
        android:id="@+id/avatarYorum"
        layout="@layout/item_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textYorumYazar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/renk_metin_baslik"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Mehmet Okyay" />

            <TextView
                android:id="@+id/textYorumZaman"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/renk_metin_ikincil"
                android:textSize="12sp"
                tools:text="5 dk. önce" />
        </LinearLayout>

        <TextView
            android:id="@+id/textYorumKullaniciAdi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/renk_metin_ikincil"
            android:textSize="12sp"
            android:textStyle="italic"
            tools:text="\@mehmet" />

        <TextView
            android:id="@+id/textYorumMetni"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/renk_metin_baslik"
            android:textSize="14sp"
            tools:text="Harika bir paylaşım!" />
    </LinearLayout>
</LinearLayout>
