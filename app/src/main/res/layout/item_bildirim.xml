<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@color/renk_kart"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/textBildirimBaslik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/renk_metin_baslik"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textBildirimMetin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/renk_metin_ikincil"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/textBildirimZaman"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/renk_metin_ikincil"
        android:textSize="12sp" />
</LinearLayout>
