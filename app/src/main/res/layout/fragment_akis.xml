<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/renk_arkaplan"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_profil_ust"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="FlowNote"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:clipChildren="false"
            android:clipToPadding="false">

            <ImageView
                android:id="@+id/iconGonderiEkle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_calendar_badge"
                android:backgroundTint="#33000000"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_add"
                app:tint="#FFFFFF" />

            <ImageView
                android:id="@+id/iconArama"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_calendar_badge"
                android:backgroundTint="#33000000"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="#FFFFFF" />

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/iconBildirimler"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/bg_calendar_badge"
                    android:backgroundTint="#33000000"
                    android:contentDescription="@string/bildirimleri_ac"
                    android:padding="6dp"
                    android:src="@android:drawable/ic_popup_reminder"
                    app:tint="#FFFFFF" />

                <TextView
                    android:id="@+id/textBildirimRozet"
                    android:layout_width="wrap_content"
                    android:layout_height="14dp"
                    android:layout_gravity="end|top"
                    android:background="@drawable/bg_okunmamis_rozet"
                    android:gravity="center"
                    android:minWidth="14dp"
                    android:paddingHorizontal="3dp"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageView
                android:id="@+id/iconMesajlar"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_calendar_badge"
                android:backgroundTint="#33000000"
                android:padding="6dp"
                android:src="@android:drawable/ic_menu_send"
                app:tint="#FFFFFF" />
        </LinearLayout>
    </RelativeLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerFeed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="80dp" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <LinearLayout
            android:id="@+id/layoutAkisBos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/akis_bos"
                android:textColor="@color/renk_metin_baslik"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAkisIlkGonderi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ilk_gonderiyi_paylas"
                app:backgroundTint="@color/renk_vurgu" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>